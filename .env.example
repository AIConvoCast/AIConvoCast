OPENAI_API_KEY=
ELEVENLABS_API_KEY=
SHARE_SHEET_WITH_EMAIL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Gmail API OAuth sends from AIConvoCast without a Gmail password or app password.
PODCAST_EMAIL_BACKEND=gmail_api
PODCAST_EMAIL_FROM=AIConvoCast@gmail.com
PODCAST_EMAIL_TO=ianeoconnell@gmail.com
# Created locally by: python configure_gmail_oauth.py
GMAIL_OAUTH_TOKEN_FILE=gmail_oauth_token.json
# GitHub Actions uses the GMAIL_OAUTH_TOKEN_B64 environment secret instead.
GMAIL_OAUTH_TOKEN_B64=
# Raw JSON is supported for compatibility but the base64 secret is preferred.
GMAIL_OAUTH_TOKEN_JSON=

# SMTP is also used automatically if Gmail cannot authorize or explicitly rejects delivery.
PODCAST_SMTP_USERNAME=
PODCAST_SMTP_PASSWORD=

# Optional historical Sol web-search step cost in USD. Restricts additional Astra
# spend; without it, the comparison is the Sol search pass for the same request.
RESEARCH_SOL_BASELINE_USD=
# Leave true to use SMTP after a definitive Gmail pre-send/auth failure.
PODCAST_SMTP_FALLBACK=true
# Interactive local runs can renew an expired default local Gmail grant.
# Never enabled on GitHub or for an explicitly supplied token secret.
PODCAST_LOCAL_REAUTHORIZE=true
