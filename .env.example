OPENAI_API_KEY=
ELEVENLABS_API_KEY=
SHARE_SHEET_WITH_EMAIL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Gmail API OAuth sends from AIConvoCast without a Gmail password or app password.
PODCAST_EMAIL_BACKEND=gmail_api
PODCAST_EMAIL_FROM=AIConvoCast@gmail.com
PODCAST_EMAIL_TO=ianeoconnell@gmail.com
# Created locally by: python configure_gmail_oauth.py
GMAIL_OAUTH_TOKEN_FILE=gmail_oauth_token.json
# GitHub Actions uses the GMAIL_OAUTH_TOKEN_B64 environment secret instead.
GMAIL_OAUTH_TOKEN_B64=
# Raw JSON is supported for compatibility but the base64 secret is preferred.
GMAIL_OAUTH_TOKEN_JSON=

# Optional legacy SMTP fallback (only used when PODCAST_EMAIL_BACKEND=smtp).
PODCAST_SMTP_USERNAME=
PODCAST_SMTP_PASSWORD=
