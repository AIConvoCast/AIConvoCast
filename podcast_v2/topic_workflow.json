{
  "name": "Single-topic episode",
  "based_on": "Used when Run AI Podcast V2 is given a custom topic; replaces the daily multi-story format.",
  "steps": [
    {
      "id": "recent_episodes",
      "type": "recent_episodes",
      "count": 15,
      "feed_url": "https://anchor.fm/s/101530384/podcast/rss"
    },
    {
      "id": "research",
      "type": "model",
      "model": "gpt-6-astra",
      "web_search": true,
      "research_instructions": "topic_research_system.txt",
      "editor_instructions": "topic_editor_system.txt",
      "parts": [
        "prompt:20",
        "text:Topic for this episode:",
        "topic",
        "text:Recent AI Convo Cast episodes, for context only (if they covered this topic, focus on what is new since):",
        "step:recent_episodes"
      ]
    },
    {
      "id": "script",
      "type": "model",
      "model": "claude-opus-5-5",
      "web_search": true,
      "parts": [
        "prompt:21",
        "text:Topic for this episode:",
        "topic",
        "text:Research material to base the script on:",
        "step:research"
      ]
    },
    {
      "id": "title",
      "type": "model",
      "model": "claude-opus-5-5",
      "web_search": false,
      "parts": [
        "prompt:12",
        "step:script"
      ]
    },
    {
      "id": "save_description",
      "type": "save_text",
      "source": "step:title",
      "folder": "descriptions/",
      "title_from": "title"
    },
    {
      "id": "save_script",
      "type": "save_text",
      "source": "step:script",
      "folder": "scripts/",
      "title_from": "title"
    },
    {
      "id": "narration",
      "type": "voice",
      "source": "gcs_latest_text:scripts/",
      "folder": "eleven-labs/",
      "title_from": "title",
      "elevenlabs": {
        "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
        "Voice": "21m00Tcm4TlvDq8ikWAM",
        "Model": "eleven_multilingual_v2",
        "Stability": 0.39,
        "Similarity Boost": 0.7,
        "Style": 0.5,
        "Speed": 1.06
      },
      "google_fallback_voice_id": "1"
    },
    {
      "id": "episode",
      "type": "merge_audio",
      "parts": [
        "gcs_file:Intro.mp3",
        "gcs_latest_mp3:eleven-labs/",
        "gcs_file:Outro.mp3"
      ],
      "folder": "podcasts/",
      "title_from": "title"
    }
  ]
}
