{
  "name": "Daily AI news episode",
  "based_on": "Google Sheet Workflow 47: PPU,PPL15,P10&P8&R2M221,P4&R3M223,P12&R4M220,R5SL10T5,R4SL7T5,L8E1SL4T5,L1&L9&L2SL3T5",
  "steps": [
    {
      "id": "recent_episodes",
      "type": "recent_episodes",
      "count": 15,
      "feed_url": "https://anchor.fm/s/101530384/podcast/rss"
    },
    {
      "id": "research",
      "type": "model",
      "model": "gpt-6-astra",
      "web_search": true,
      "parts": ["prompt:10", "prompt:8", "step:recent_episodes"]
    },
    {
      "id": "script",
      "type": "model",
      "model": "claude-opus-5-5",
      "web_search": true,
      "parts": ["prompt:4", "script_tuning", "step:research"]
    },
    {
      "id": "title",
      "type": "model",
      "model": "claude-opus-5-5",
      "web_search": false,
      "parts": ["prompt:12", "step:script", "script_tuning"]
    },
    {
      "id": "save_description",
      "type": "save_text",
      "source": "step:title",
      "folder": "descriptions/",
      "title_from": "title"
    },
    {
      "id": "save_script",
      "type": "save_text",
      "source": "step:script",
      "folder": "scripts/",
      "title_from": "title"
    },
    {
      "id": "narration",
      "type": "voice",
      "source": "gcs_latest_text:scripts/",
      "folder": "eleven-labs/",
      "title_from": "title",
      "elevenlabs": {
        "voice_id": "TX3LPaxmHKxFdv7VOQHJ",
        "Voice": "Liam",
        "Model": "eleven_v3",
        "Stability": 0.5,
        "Similarity Boost": 0.7,
        "Style": 0.0,
        "Speed": 1.06
      },
      "google_fallback_voice_id": "1"
    },
    {
      "id": "episode",
      "type": "merge_audio",
      "parts": ["gcs_file:Intro.mp3", "gcs_latest_mp3:eleven-labs/", "gcs_file:Outro.mp3"],
      "folder": "podcasts/",
      "title_from": "title"
    }
  ]
}
